{
  "name": "Example browser instructions",
  "description": "Example description",
  "dataSources": [
    {
      "name": "credentials",
      "path": "./data/credentials.csv",
      "columns": [
        {
          "name": "username",
          "type": "text"
        },
        {
          "name": "password",
          "type": "text"
        },
        {
          "name": "time",
          "type": "now"
        }
      ]
    }
  ],
  "steps": [
    // Navigate to some starting page
    {
      "type": "page-action",
      "pageIndex": 0,
      "action": {
        "type": "navigate",
        "url": "http://example.com"
      }
    },
    // Run agent task
    {
      "type": "agent",
      "task": "Find the latest version of the Rust programming language and print it as a result.",
      "promptMode": "standard",
      "maxSteps": 24,
      // It will be saved to a path relative to this workflow file
      // History will be saved only when agent finishes successfully
      // Existing file will be overridden
      "historyOutput": "./rust-version.json",
      "judge": {
        "onCaptcha": "TODO",
        "onImpossibleTask": "TODO"
      }
    }
  ]
}
